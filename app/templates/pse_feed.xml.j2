<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ feed_id }}</id>
  <updated>{{ updated }}</updated>
  <title>{{ title }}</title>

  <link rel="self" href="{{ self_href }}" />
  <link rel="start" href="{{ start_href }}" />

  {% for e in entries -%}
  {{ e | safe }}
  {% endfor %}
</feed>
